generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum Role {
  SUPER_ADMIN
  ADMIN
  USER
  VIEWER
}

enum Plan {
  FREE
  PRO
  ENTERPRISE
}

enum InvoiceStatus {
  DRAFT
  SENT
  PAID
  OVERDUE
  CANCELLED
}

enum QuotationStatus {
  DRAFT
  SENT
  ACCEPTED
  REJECTED
  EXPIRED
}

enum PaymentMethod {
  CASH
  BANK_TRANSFER
  CHECK
  POS
  MOBILE_MONEY
}

model Organization {
  id        String    @id @default(uuid())
  name      String
  plan      Plan      @default(FREE)
  companies Company[]
  users     User[]
}

model Company {
  id                       String    @id @default(uuid())
  organizationId           String
  organization             Organization @relation(fields: [organizationId], references: [id])
  name                     String
  nuit                     String
  address                  String
  email                    String
  phone                    String?
  logoUrl                  String?
  brandColor               String?
  defaultTaxRate           Float?
  defaultDueDays           Int?
  mpesaNumber              String?
  emolaNumber              String?
  paymentNotes             String?   @db.Text
  currentInvoiceSequence   Int       @default(1)
  currentReceiptSequence   Int       @default(1)
  currentQuotationSequence Int       @default(1)

  bankAccounts BankAccount[]
  clients      Client[]
  products     Product[]
  invoices     Invoice[]
  quotations   Quotation[]
  receipts     Receipt[]
  userAccess   UserCompanyAccess[]

  @@index([organizationId])
}

model BankAccount {
  id             String  @id @default(uuid())
  companyId      String
  company        Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  bankName       String
  accountHolder  String?
  accountNumber  String
  nib            String?
  iban           String?
  swiftCode      String?
  currency       String  @default("MZN")

  @@index([companyId])
}

model User {
  id                String   @id @default(uuid())
  organizationId    String
  organization      Organization @relation(fields: [organizationId], references: [id])
  name              String
  email             String   @unique
  passwordHash      String
  role              Role     @default(USER)

  allowedCompanies  UserCompanyAccess[]

  @@index([organizationId])
}

model UserCompanyAccess {
  userId    String
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@id([userId, companyId])
}

model Client {
  id        String   @id @default(uuid())
  companyId String
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name      String
  nuit      String
  address   String
  email     String
  phone     String?

  invoices   Invoice[]
  quotations Quotation[]

  @@index([companyId])
}

model Product {
  id          String  @id @default(uuid())
  companyId   String
  company     Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name        String
  description String? @db.Text
  unit        String
  unitPrice   Float
  taxRate     Float?

  @@index([companyId])
}

model Invoice {
  id           String        @id @default(uuid())
  companyId    String
  company      Company       @relation(fields: [companyId], references: [id])
  clientId     String
  client       Client        @relation(fields: [clientId], references: [id])
  number       String
  date         DateTime
  dueDate      DateTime
  status       InvoiceStatus @default(SENT)
  subtotal     Float
  taxTotal     Float
  total        Float
  notes        String?       @db.Text
  reference    String?       @db.Text
  createdBy    String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  items    InvoiceItem[]
  receipts Receipt[]

  @@index([companyId])
  @@index([clientId])
}

model InvoiceItem {
  id          String  @id @default(uuid())
  invoiceId   String
  invoice     Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  description String
  quantity    Float
  unitPrice   Float
  taxRate     Float
  total       Float

  @@index([invoiceId])
}

model Quotation {
  id                String          @id @default(uuid())
  companyId         String
  company           Company         @relation(fields: [companyId], references: [id])
  clientId          String
  client            Client          @relation(fields: [clientId], references: [id])
  number            String
  date              DateTime
  validUntil        DateTime
  status            QuotationStatus @default(DRAFT)
  subtotal          Float
  taxTotal          Float
  total             Float
  notes             String?         @db.Text
  reference         String?         @db.Text
  createdBy         String?
  convertedInvoiceId String?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  items QuotationItem[]

  @@index([companyId])
  @@index([clientId])
}

model QuotationItem {
  id          String    @id @default(uuid())
  quotationId String
  quotation   Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  description String
  quantity    Float
  unitPrice   Float
  taxRate     Float
  total       Float

  @@index([quotationId])
}

model Receipt {
  id        String        @id @default(uuid())
  companyId String
  company   Company       @relation(fields: [companyId], references: [id])
  invoiceId String
  invoice   Invoice       @relation(fields: [invoiceId], references: [id])
  number    String
  date      DateTime
  amount    Float
  method    PaymentMethod
  reference String?
  voided    Boolean       @default(false)
  createdAt DateTime      @default(now())

  @@index([companyId])
  @@index([invoiceId])
}
